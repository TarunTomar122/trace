# Environment Variables Template
# Copy this to .env.local for local development
# Add these to Vercel Dashboard for production deployment

# Alpha Mode Feature Flag (set to "true" for full access, "false" for waitlist mode)
NEXT_PUBLIC_ALPHA_MODE=true

# OpenAI API Key (for chat functionality)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin SDK Service Account Key (JSON string)
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"..."}
# Firebase Storage bucket used for generated Instagram images
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# GitHub API (for triggering onboard workflow)
# Create a Personal Access Token with "repo" scope at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your-username/claudia

# Dodo Payments Configuration (for subscriptions)
DODO_API_KEY=sk_your_key_here
DODO_PRODUCT_ID=prod_your_product_id_here
DODO_PRODUCT_ID_INDIA=prod_your_india_product_id_here
DODO_WEBHOOK_SECRET=whsec_your_secret_here
DODO_MODE=test
SUBSCRIPTION_PRICE_DISPLAY_DEFAULT=$10/month
SUBSCRIPTION_PRICE_DISPLAY_INDIA=₹199/month
SUBSCRIPTION_TRIAL_DAYS_DEFAULT=3
SUBSCRIPTION_TRIAL_DAYS_INDIA=1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog Analytics (get from https://app.posthog.com/settings/project)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Instagram / Facebook Login for Instagram Business publishing
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://yourtrace.online/auth/instagram/callback
# Optional (defaults to v23.0)
INSTAGRAM_GRAPH_VERSION=v23.0
# Optional: render secret if you later want public/protected render URLs
INSTAGRAM_RENDER_SECRET=your_random_secret
# Required to protect /instagram-studio and its API endpoints in production
INSTAGRAM_STUDIO_ACCESS_KEY=set_a_long_random_secret
# Dev studio manual publish defaults (server-side only)
INSTAGRAM_ACCESS_TOKEN_DEV=your_instagram_user_access_token
INSTAGRAM_IG_USER_ID_DEV=1784...
INSTAGRAM_PAGE_ID_DEV=1107...
