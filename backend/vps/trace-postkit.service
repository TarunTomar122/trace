[Unit]
Description=Trace daily X post for the founder (written here, finished on the laptop)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
TimeoutStartSec=30min
WorkingDirectory=%h/trace/backend
EnvironmentFile=%h/trace/.env
# The job takes ~/trace/.postkit.lock itself and keeps the day's post in
# post_kits/{date}, so the laptop's run gets the same post and the model is asked once.
ExecStart=%h/trace/.venv/bin/python -u -m v3.flows.build_post_kit
# A failed run (no feed yet, the database down) retries.
Restart=on-failure
RestartSec=15min
StandardOutput=append:%h/trace/logs/postkit.log
StandardError=append:%h/trace/logs/postkit.log
