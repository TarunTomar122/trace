# Stable public endpoint for Vercel -> VPS LocalDB traffic.
# Keep LocalDB itself bound to 127.0.0.1:8502.
# Add `import /path/to/this/snippet` to the main Caddyfile (or paste the block).
# Requires DNS: db.yourtrace.online -> A 144.217.6.112 (proxied OFF).
db.yourtrace.online {
	bind 144.217.6.112
	# Instagram carousel slides (backend/v3/flows/post_instagram.py); Buffer fetches them.
	handle_path /social/* {
		root * /var/www/trace-social
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8502
	}
}
