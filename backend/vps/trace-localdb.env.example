# /etc/trace/localdb.env — chmod 600, owned by ubuntu. NEVER commit real values.
# Bearer token for LocalDB HTTP auth (Vercel LOCALDB_API_TOKEN must match).
LOCALDB_API_TOKEN=change-me-to-a-long-random-token
# Root collections this instance serves (first path segment; everything else 403s).
LOCALDB_ALLOWED_COLLECTIONS=user_profiles,user_preferences,user_patterns,user_streaks,user_bookmarks,user_interactions,user_seen_urls,user_weekly_wraps,user_integrations,free_reads,free_newsletter_subscribers,feedback,extension_sessions,agent_access_keys,promoted_tools,daily_editions,email_sends,email_events,affiliate_codes,affiliate_clicks,affiliate_conversions,app_config,v3_user_feeds,v3_trending_pool,v3_deep_dive_pool,v3_for_you_pool,v3_summary_cache,v3_synthesis_cache,v3_extraction_cache,v3_seen_urls,v3_pipeline_runs,v3_push_notifications,v3_curated_queue,newsletter_editions,unified_newsletters,trending_news,topics,user_feeds,feed_jobs
