# Trace - consolidated environment reference.
# Copy to .env and fill in. Values are blank on purpose. NEVER commit .env.
# Required variables are uncommented; optional ones are commented out - uncomment
# only what you use (blank values can override defaults and break int parsing).
# [R] = required for that component, [O] = optional (has a default / feature off).

############################################################
# Storage mode
############################################################
# [pipeline] firebase (default, real Firestore) | local (SQLite) | dual
# docker-compose sets this to "local" for you.
TRACE_DB=local
# [pipeline, local mode] path to the SQLite file shared with the LocalDB server
# TRACE_LOCALDB_PATH=
# [frontend] firebase (default) | local | fallback
FIRESTORE_BACKEND=local

############################################################
# LocalDB HTTP server (backend/localdb/server.py)
############################################################
# [R] Shared bearer token. Frontend (LOCALDB_API_TOKEN) must match the server.
#     Generate: openssl rand -hex 32
LOCALDB_API_TOKEN=
# [O] SQLite path used by the server (docker-compose sets /data/documents.sqlite3)
# LOCALDB_PATH=
# LOCALDB_HOST=
# LOCALDB_PORT=
# [R for server] comma-separated root collections the server will serve
# (anything else returns 403). See backend/vps/trace-localdb.env.example for a
# full list, or use the one set as default in docker-compose.yml.
# LOCALDB_ALLOWED_COLLECTIONS=
# [R frontend] where the frontend reaches LocalDB (docker-compose: http://localdb:8502)
# LOCALDB_URL=

############################################################
# LLM / content APIs (pipeline)
############################################################
# [R] OpenAI: article summaries, topic grouping, ranking, newsletter copy
OPENAI_API_KEY=
# [O] model overrides
# NEWSLETTER_WRITE_MODEL=
# NEWSLETTER_PICK_MODEL=
# HEADLINE_MODEL=
# HOME_BRIEFING_MODEL=
# TRENDING_GROUP_EMBED_MODEL=
# [O] Typesafe "Jev" quality/grouping judge. Skipped when unset.
# Editorial judgements (grouping, ranking, send-worthiness) use OpenAI
# structured outputs with OPENAI_API_KEY; override the model if you like.
# DECISION_MODEL=gpt-4o-mini
# NEWSLETTER_JEV_BATCH=
# [O] Exa search (extra article content). Skipped when unset.
# EXA_API_KEY=
# [O] Firecrawl base URL for coverage enrichment (--enrich-coverage)
# FIRECRAWL_URL=
# [O] Product Hunt (pulse feed). Skipped when unset.
# PRODUCT_HUNT_API_KEY=
# PRODUCT_HUNT_API_SECRET=
# [O] X/Twitter bearer for curated feed. Skipped when unset.
# X_API_BEARER_TOKEN=
# TWITTER_BEARER_TOKEN=

############################################################
# Firebase (Auth is always Firebase; Firestore only if TRACE_DB/FIRESTORE_BACKEND != local)
############################################################
# [R frontend] service-account JSON as a single-line string, or a file path
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_STORAGE_BUCKET=
# [pipeline, only when TRACE_DB=firebase|dual]
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# The browser-side Firebase web config is NEXT_PUBLIC_FIREBASE_* (Frontend below).

############################################################
# Email (daily brief)
############################################################
# smtp (default: own MTA only) | brevo | auto (MTA + Brevo routing/fallback)
EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_TIMEOUT=
# EMAIL_SENDER_LOCAL=
# EMAIL_SENDER_NAME=
# EMAIL_REPLY_TO=
# DKIM signing for the self-hosted MTA path
EMAIL_DKIM=1
# EMAIL_DKIM_DOMAIN=
# EMAIL_DKIM_SELECTOR=
# EMAIL_DKIM_KEY=
# Brevo (only when EMAIL_TRANSPORT=brevo|auto)
# BREVO_API_KEY=
# EMAIL_SENDER_BREVO=
# EMAIL_SENDER_BREVO_NAME=
# Comma list of audience buckets routed via Brevo: member, winback, landing
# EMAIL_BREVO_BUCKETS=
# EMAIL_BREVO_DOMAINS=
# 0 disables open/click tracking links
EMAIL_TRACKING=1
# NEWSLETTER_WAIT_MINUTES=
# Win-back run for dormant readers: needs =1 AND `winback` listed in EMAIL_BREVO_BUCKETS
# NEWSLETTER_WINBACK=
# NEWSLETTER_WINBACK_DAILY_CAP=250

# Public URL of your web app; every link in the daily email is built from it
TRACE_APP_URL=http://localhost:3000

############################################################
# Optional: Instagram carousels via Buffer (backend/v3/flows/post_instagram.py)
############################################################
# BUFFER_API_KEY=
# Found automatically when unset (first connected Instagram channel)
# BUFFER_INSTAGRAM_CHANNEL_ID=
# Where slides are written, and the public HTTPS URL that serves that folder
# INSTAGRAM_MEDIA_DIR=/var/www/trace-social
# INSTAGRAM_MEDIA_URL=https://db.yourtrace.online/social
# Story order, one story per entry (two AI, then Markets, Startups, Design)
# INSTAGRAM_LANES=ai,ai,markets,startups,ux-design
# INSTAGRAM_MIN_STORIES=3
# INSTAGRAM_MAX_STORIES=5
# INSTAGRAM_COPY_MODEL=gpt-4.1-mini

############################################################
# Frontend (Next.js)
############################################################
# [R] long random string used to sign session cookies
TRACE_SESSION_SECRET=
# [R] public site URL (build-time for NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
# [O] public origin of this instance for MCP sign-in (OAuth issuer and the
#     /api/mcp resource), e.g. https://trace.example.com. Production defaults
#     to https://www.yourtrace.online; dev uses the request's own origin.
# TRACE_OAUTH_ORIGIN=
# Contact/support address on contact, privacy, terms and delete-account pages
# NEXT_PUBLIC_CONTACT_EMAIL=
# Link to your fork; the "Open source" links stay hidden while this is empty
# NEXT_PUBLIC_GITHUB_REPO_URL=
# [R] Firebase web config (sign-in). Firebase console -> Project settings -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# [O] analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# POSTHOG_PERSONAL_API_KEY=
# [O] chat endpoint
# (uses OPENAI_API_KEY above)

############################################################
# Frontend: optional / owner-only features (safe to leave blank)
############################################################
# TRACE_CONTROL_PLANE_PASSWORD=
# TRACE_CONTROL_PLANE_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=
# INSTAGRAM_GRAPH_VERSION=
# INSTAGRAM_RENDER_BASE_URL=
# INSTAGRAM_RENDER_SECRET=
# INSTAGRAM_STUDIO_ACCESS_KEY=
# INSTAGRAM_STUDIO_TIMEZONE=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN_DEV=
# INSTAGRAM_IG_USER_ID_DEV=
# INSTAGRAM_PAGE_ID_DEV=
# POSTIZ_API_URL=
# POSTIZ_EMAIL=
# POSTIZ_PASSWORD=
# POSTIZ_INSTAGRAM_INTEGRATION_ID=
# CAROUSEL_API_KEY=
# OPENCLAW_CAROUSEL_API_KEY=
# GITHUB_TOKEN=
# GITHUB_REPO=
# Optional: payments for sponsored-tool listings (Dodo). Leave unset to disable.
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_MODE=
