# Copy to .env.local and fill. Only VITE_* vars reach the browser.
# Server-only keys (OpenAI, Runway, Dodo secret, Brevo, Firebase admin) live in the
# backend / repo-root .env — never expose them with a VITE_ prefix.

# --- Firebase (client) — share the Trace project: anybrew-7c6c1 ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=anybrew-7c6c1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=anybrew-7c6c1
VITE_FIREBASE_STORAGE_BUCKET=anybrew-7c6c1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Dodo Payments (public product/checkout config; secret stays server-side) ---
VITE_DODO_PRODUCT_ID=

# --- Server-only (DO NOT prefix with VITE_). Documented here for reference. ---
# OPENAI_API_KEY=          # gpt-5 script
# RUNWAY_API_KEY=          # seed_audio voice
# DODO_API_KEY=            # checkout sessions
# DODO_WEBHOOK_SECRET=     # subscription webhook
# BREVO_API_KEY=           # daily email
# FIREBASE_SERVICE_ACCOUNT_KEY=  # admin SDK (Storage + Firestore writes)
